# Project & API Meta
PROJECT_NAME=AgriMind AI
VERSION=1.0.0
API_V1_STR=/api/v1

# Production Security & JWT Keys
SECRET_KEY=YOUR_PRODUCTION_JWT_SECRET_KEY_CHANGE_THIS
REFRESH_SECRET_KEY=YOUR_PRODUCTION_REFRESH_SECRET_KEY_CHANGE_THIS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (Comma-separated or JSON list of deployed frontend URLs)
CORS_ORIGINS=["https://agrimind-ai.vercel.app","http://localhost:5173","*"]

# Database Connection (Neon PostgreSQL / Supabase / Render PostgreSQL)
DATABASE_URL=postgresql://postgres:password@ep-cool-db-123456.us-east-1.aws.neon.tech/agrimind_db?sslmode=require

# Machine Learning Model Weights Path
KERAS_MODEL_PATH=ml/models/crop_disease_model.keras
CLASS_MAPPING_PATH=ml/models/class_names.json
MODEL_METADATA_PATH=ml/models/model_metadata.json
CONFIDENCE_THRESHOLD=0.60
