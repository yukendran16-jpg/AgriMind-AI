# AgriMind AI Environment Configuration

# Project Metadata
PROJECT_NAME="AgriMind AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

# Enterprise Security & JWT Secrets
SECRET_KEY="AGRIMIND_SECRET_KEY_SUPER_SECURE_PRODUCTION_GRADE_12345"
REFRESH_SECRET_KEY="AGRIMIND_REFRESH_SECRET_KEY_SUPER_SECURE_PRODUCTION_GRADE_67890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/agrimind_db"

# Redis Session Store
REDIS_URL="redis://localhost:6379/0"

# Google OAuth Integration
GOOGLE_CLIENT_ID="google-client-id-placeholder.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="google-client-secret-placeholder"

# AI Inference Engine
MODEL_WEIGHTS_PATH="app/ai_engine/weights/tomato_v8.pt"
DEVICE="cpu"
